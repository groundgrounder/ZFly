diff --git a/lib/native/control_bridge.dart b/lib/native/control_bridge.dart
new file mode 100644
index 00000000..7634af2c
--- /dev/null
+++ b/lib/native/control_bridge.dart
@@ -0,0 +1,435 @@
+import 'dart:convert';
+import 'dart:isolate';
+import 'dart:typed_data';
+
+import 'package:crypto/crypto.dart';
+import 'package:fl_clash/common/common.dart';
+import 'package:fl_clash/enum/enum.dart';
+import 'package:fl_clash/models/models.dart';
+import 'package:fl_clash/providers/providers.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import 'control_server.dart';
+import 'control_workspace.dart';
+import 'control_catalog.dart';
+
+Future<Map<String, String>> _filePayload(Uint8List bytes) => Isolate.run(
+  () => {
+    'data': base64Encode(bytes),
+    'revision': md5.convert(bytes).toString(),
+  },
+);
+
+class NativeControlBridge {
+  final ProviderContainer container;
+  late final server = NativeControlServer(
+    secret: () => container.read(patchClashConfigProvider).secret,
+    snapshot: snapshot,
+    action: _action,
+  );
+
+  NativeControlBridge(this.container);
+
+  Future<Map<String, Object?>> snapshot() async {
+    final patch = container.read(patchClashConfigProvider);
+    final network = container.read(networkSettingProvider);
+    return {
+      'apiVersion': 1,
+      'currentProfileID': container.read(currentProfileIdProvider)?.toString(),
+      'running': container.read(isStartProvider),
+      'coreStatus': container.read(coreStatusProvider).name,
+      'tunAuthorization': container.read(authorizedTunEnableProvider).name,
+      'profiles': [
+        for (final profile in container.read(profilesProvider))
+          {
+            'id': profile.id.toString(),
+            'label': profile.realLabel,
+            'type': profile.type.name,
+            'url': profile.url,
+            'autoUpdate': profile.autoUpdate,
+            'updateHours': profile.autoUpdateDuration.inHours,
+            'updated': profile.lastUpdateDate?.toIso8601String(),
+            'upload': profile.subscriptionInfo?.upload,
+            'download': profile.subscriptionInfo?.download,
+            'total': profile.subscriptionInfo?.total,
+            'expire': profile.subscriptionInfo?.expire,
+          },
+      ],
+      'network': {
+        'tunEnabled': patch.tun.enable,
+        'tunStack': patch.tun.stack.name,
+        'tunDevice': patch.tun.device,
+        'systemProxy': network.systemProxy,
+        'bypassDomains': network.bypassDomain,
+        'bypassPrivateRoute': network.bypassPrivateRoute,
+        'autoSetSystemDns': network.autoSetSystemDns,
+        'appendSystemDns': network.appendSystemDns,
+        'mode': patch.mode.name,
+        'mixedPort': patch.mixedPort,
+        'ipv6': patch.ipv6,
+        'allowLan': patch.allowLan,
+        'tcpConcurrent': patch.tcpConcurrent,
+        'logLevel': patch.logLevel.name,
+      },
+    };
+  }
+
+  Profile _profile(Map<String, Object?> command) {
+    final id = int.tryParse(command['id']?.toString() ?? '');
+    final profile = container.read(profilesProvider).getProfile(id);
+    if (profile == null) {
+      throw const NativeControlException('配置已不存在，请刷新列表。', 404);
+    }
+    return profile;
+  }
+
+  String _text(Map<String, Object?> command, String key) {
+    final value = command[key];
+    if (value is! String) {
+      throw NativeControlException('缺少字段：$key');
+    }
+    return value;
+  }
+
+  Future<Map<String, Object?>> _action(Map<String, Object?> command) async {
+    final profiles = container.read(profilesActionProvider.notifier);
+    final setup = container.read(setupActionProvider.notifier);
+    switch (command['action']) {
+      case 'catalog.list':
+        return {
+          'state': await snapshot(),
+          'items': await NativeCatalog(
+            container,
+          ).list(_text(command, 'section'), command['name'] as String?),
+        };
+      case 'catalog.read':
+        return {
+          'state': await snapshot(),
+          'document': await NativeCatalog(container).read(
+            _text(command, 'section'),
+            command['id'] as String?,
+            command['name'] as String?,
+          ),
+        };
+      case 'catalog.save':
+        await NativeCatalog(container).save(
+          _text(command, 'section'),
+          command['id'] as String?,
+          command['name'] as String?,
+          _text(command, 'text'),
+          _text(command, 'revision'),
+        );
+      case 'catalog.delete':
+        await NativeCatalog(container).delete(
+          _text(command, 'section'),
+          _text(command, 'id'),
+          command['name'] as String?,
+          _text(command, 'revision'),
+        );
+      case 'profile.create':
+        await _put(Profile.custom(label: _text(command, 'label')));
+      case 'workspace.read':
+        return {
+          'state': await snapshot(),
+          'document': await NativeWorkspace(
+            container,
+          ).read(_text(command, 'section'), command['id'] as String?),
+        };
+      case 'workspace.write':
+        final document = await NativeWorkspace(container).write(
+          _text(command, 'section'),
+          command['id'] as String?,
+          _text(command, 'text'),
+          _text(command, 'revision'),
+        );
+        return {'state': await snapshot(), 'document': document};
+      case 'tool.run':
+        try {
+          final message = await NativeWorkspace(
+            container,
+          ).tool(_text(command, 'tool'), command['name'] as String?);
+          return {'state': await snapshot(), 'message': message};
+        } on MessageException catch (error) {
+          throw NativeControlException(error.message, 422);
+        }
+      case 'proxy.select':
+        await _selectProxy(_text(command, 'group'), _text(command, 'proxy'));
+      case 'profile.add':
+        final url = _text(command, 'url').trim();
+        final uri = Uri.tryParse(url);
+        if (uri == null ||
+            !['http', 'https'].contains(uri.scheme) ||
+            uri.host.isEmpty) {
+          throw const NativeControlException('请输入 HTTP 或 HTTPS 订阅地址。');
+        }
+        final profile =
+            await Profile.normal(label: command['label'] as String?, url: url)
+                .copyWith(
+                  ageSecretKey: command['ageSecretKey'] as String? ?? '',
+                  autoUpdate: command['autoUpdate'] as bool? ?? true,
+                  autoUpdateDuration: Duration(hours: _hours(command)),
+                )
+                .update(
+                  validate: (path, key) => container
+                      .read(coreHandlerProvider)
+                      .validateProfile(path, key),
+                );
+        await _put(profile);
+      case 'profile.import':
+        final bytes = await _bytes(command);
+        final profile = await Profile.normal(label: _text(command, 'label'))
+            .saveFile(
+              bytes,
+              validate: (path, key) => container
+                  .read(coreHandlerProvider)
+                  .validateProfile(path, key),
+            );
+        await _put(profile);
+      case 'profile.select':
+        final profile = _profile(command);
+        container.read(currentProfileIdProvider.notifier).value = profile.id;
+      case 'profile.update':
+        final profile = _profile(command);
+        if (profile.type != ProfileType.url) {
+          throw const NativeControlException('此配置不是订阅。');
+        }
+        await profiles.updateProfile(profile);
+      case 'profile.edit':
+        final profile = _profile(command);
+        final hours = _hours(command);
+        if (command['autoUpdate'] is! bool) {
+          throw const NativeControlException('自动更新间隔应为 1–8760 小时。');
+        }
+        final url = command['url'] as String? ?? profile.url;
+        final uri = Uri.tryParse(url);
+        if (profile.type == ProfileType.url &&
+            (uri == null ||
+                !['http', 'https'].contains(uri.scheme) ||
+                uri.host.isEmpty)) {
+          throw const NativeControlException('请输入 HTTP 或 HTTPS 订阅地址。');
+        }
+        await container
+            .read(profilesProvider.notifier)
+            .putAndWait(
+              profile.copyWith(
+                label: _text(command, 'label'),
+                url: url,
+                autoUpdate: command['autoUpdate'] as bool,
+                autoUpdateDuration: Duration(hours: hours),
+              ),
+            );
+      case 'profile.delete':
+        final profile = _profile(command);
+        if ((await profiles.providerUsers(profile)).isNotEmpty) {
+          throw const NativeControlException(
+            '其他配置仍引用此配置，请先在 FlClash 中移除引用。',
+            409,
+          );
+        }
+        await profiles.deleteProfile(profile.id);
+      case 'profile.read':
+        final profile = _profile(command);
+        if (profile.type == ProfileType.custom) {
+          final built = await setup.getProfile(
+            setupState: await container.read(
+              setupStateProvider(profile.id).future,
+            ),
+            patchConfig: container.read(patchClashConfigProvider),
+          );
+          final content = built.base == null
+              ? built.yaml
+              : await container
+                    .read(coreHandlerProvider)
+                    .buildProfile(built.base!);
+          final bytes = await Isolate.run(
+            () => Uint8List.fromList(utf8.encode(content)),
+          );
+          if (bytes.length > 4 * 1024 * 1024)
+            throw const NativeControlException('导出内容不能超过 4 MiB。', 413);
+          return {
+            'state': await snapshot(),
+            'file': {
+              'name': profile.exportFileName,
+              ...await _filePayload(bytes),
+            },
+          };
+        }
+        final file = await profile.file;
+        if (await file.length() > 4 * 1024 * 1024) {
+          throw const NativeControlException('原生编辑器支持 4 MiB 以内的配置。');
+        }
+        final bytes = await file.readAsBytes();
+        final encoded = await _filePayload(bytes);
+        return {
+          'state': await snapshot(),
+          'file': {'name': profile.exportFileName, ...encoded},
+        };
+      case 'profile.write':
+        final profile = _profile(command);
+        if (profile.type != ProfileType.file ||
+            profile.ageSecretKey.isNotEmpty) {
+          throw const NativeControlException('仅本地未加密配置可直接编辑；订阅请编辑源配置后更新。');
+        }
+        final file = await profile.file;
+        if (await _revision(await file.readAsBytes()) != command['revision']) {
+          throw const NativeControlException('文件已被修改，请重新打开后编辑。', 409);
+        }
+        final saved = await profile.saveFile(
+          await _bytes(command),
+          validate: (path, key) =>
+              container.read(coreHandlerProvider).validateProfile(path, key),
+        );
+        await container.read(profilesProvider.notifier).putAndWait(saved);
+        if (container.read(currentProfileIdProvider) == profile.id &&
+            !await setup.applyProfile(force: true)) {
+          throw const NativeControlException('文件已保存，但核心应用失败。', 422);
+        }
+      case 'network.save':
+        await _network(command);
+      case 'running.set':
+        final running = command['running'];
+        if (running is! bool || !await setup.setRunning(running)) {
+          throw const NativeControlException('核心未完成启动或停止，请查看 FlClash。', 422);
+        }
+      default:
+        throw const NativeControlException('不支持的管理操作。');
+    }
+    if (!await preferences.saveConfig(container.read(configProvider))) {
+      throw const NativeControlException('操作已执行，但偏好保存失败。', 500);
+    }
+    return {'state': await snapshot()};
+  }
+
+  Future<void> _selectProxy(String group, String proxy) async {
+    final profile = container.read(currentProfileProvider);
+    if (profile == null) throw const NativeControlException('请先选择配置。');
+    final core = container.read(coreHandlerProvider);
+    final result = await core.changeProxy(
+      ChangeProxyParams(groupName: group, proxyName: proxy),
+    );
+    if (result.message.isNotEmpty)
+      throw NativeControlException(result.message, 422);
+    final latest = container.read(profilesProvider).getProfile(profile.id);
+    if (latest == null) throw const NativeControlException('配置已被删除。', 409);
+    await container
+        .read(profilesProvider.notifier)
+        .putAndWait(
+          latest.copyWith(selectedMap: {...latest.selectedMap, group: proxy}),
+        );
+    if (result.changed) {
+      if (container.read(appSettingProvider).closeConnections) {
+        await core.closeConnections();
+      } else {
+        await core.resetConnections();
+      }
+    }
+    await container.read(proxiesActionProvider.notifier).updateGroups();
+  }
+
+  int _hours(Map<String, Object?> command) {
+    final hours = command['updateHours'] ?? 24;
+    if (hours is! int || hours < 1 || hours > 8760) {
+      throw const NativeControlException('自动更新间隔应为 1–8760 小时。');
+    }
+    return hours;
+  }
+
+  Future<Uint8List> _bytes(Map<String, Object?> command) async {
+    final encoded = _text(command, 'data');
+    final bytes = await Isolate.run(() => base64Decode(encoded));
+    if (bytes.length > 4 * 1024 * 1024) {
+      throw const NativeControlException('配置文件不能超过 4 MiB。', 413);
+    }
+    return bytes;
+  }
+
+  Future<String> _revision(Uint8List bytes) =>
+      Isolate.run(() => md5.convert(bytes).toString());
+
+  Future<void> _put(Profile profile) async {
+    await container.read(profilesProvider.notifier).putAndWait(profile);
+    if (container.read(currentProfileIdProvider) == null) {
+      container.read(currentProfileIdProvider.notifier).value = profile.id;
+    }
+  }
+
+  Future<void> _network(Map<String, Object?> command) async {
+    final value = command['network'];
+    if (value is! Map<String, dynamic>) {
+      throw const NativeControlException('网络设置格式无效。');
+    }
+    final current = (await snapshot())['network'] as Map<String, Object?>;
+    final expected = command['expected'];
+    if (expected is! Map<String, dynamic>) {
+      throw const NativeControlException('请先载入网络设置。');
+    }
+    for (final key in value.keys) {
+      if (!current.containsKey(key) ||
+          jsonEncode(expected[key]) != jsonEncode(current[key])) {
+        throw const NativeControlException('网络设置已在其他界面修改，请重新载入。', 409);
+      }
+    }
+    final merged = {...current, ...value};
+    for (final key in [
+      'tunEnabled',
+      'systemProxy',
+      'bypassPrivateRoute',
+      'autoSetSystemDns',
+      'appendSystemDns',
+      'ipv6',
+      'allowLan',
+      'tcpConcurrent',
+    ]) {
+      if (merged[key] is! bool) throw const NativeControlException('开关值无效。');
+    }
+    final port = merged['mixedPort'];
+    final domains = merged['bypassDomains'];
+    if (port is! int ||
+        port < 1 ||
+        port > 65535 ||
+        domains is! List ||
+        domains.any(
+          (item) => item is! String || item.contains(RegExp(r'[\r\n]')),
+        ) ||
+        merged['tunDevice'] is! String ||
+        ((merged['tunDevice'] as String).trim().isEmpty ||
+            (merged['tunDevice'] as String).contains(
+              RegExp(r'[\x00-\x1f\x7f]'),
+            ))) {
+      throw const NativeControlException('请检查端口、TUN 设备名和绕过地址。');
+    }
+    T choice<T extends Enum>(List<T> values, String key) {
+      for (final item in values) {
+        if (item.name == merged[key]) return item;
+      }
+      throw NativeControlException('不支持的设置：$key');
+    }
+
+    final old = container.read(patchClashConfigProvider);
+    final patch = old.copyWith(
+      mode: choice(Mode.values, 'mode'),
+      mixedPort: port,
+      ipv6: merged['ipv6'] as bool,
+      allowLan: merged['allowLan'] as bool,
+      tcpConcurrent: merged['tcpConcurrent'] as bool,
+      logLevel: choice(LogLevel.values, 'logLevel'),
+      tun: old.tun.copyWith(
+        enable: merged['tunEnabled'] as bool,
+        stack: choice(TunStack.values, 'tunStack'),
+        device: merged['tunDevice'] as String,
+      ),
+    );
+    container.read(patchClashConfigProvider.notifier).value = patch;
+    container
+        .read(networkSettingProvider.notifier)
+        .update(
+          (state) => state.copyWith(
+            systemProxy: merged['systemProxy'] as bool,
+            bypassDomain: domains.cast<String>(),
+            bypassPrivateRoute: merged['bypassPrivateRoute'] as bool,
+            autoSetSystemDns: merged['autoSetSystemDns'] as bool,
+            appendSystemDns: merged['appendSystemDns'] as bool,
+          ),
+        );
+  }
+}
diff --git a/lib/native/control_catalog.dart b/lib/native/control_catalog.dart
new file mode 100644
index 00000000..63185c12
--- /dev/null
+++ b/lib/native/control_catalog.dart
@@ -0,0 +1,360 @@
+import 'dart:convert';
+import 'dart:isolate';
+
+import 'package:collection/collection.dart';
+import 'package:fl_clash/common/common.dart';
+import 'package:fl_clash/enum/enum.dart';
+import 'package:fl_clash/models/models.dart';
+import 'package:fl_clash/providers/providers.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import 'control_server.dart';
+import 'control_workspace.dart';
+
+const _kinds = {'proxies', 'groups', 'scripts'};
+
+class NativeCatalog {
+  final ProviderContainer container;
+  NativeCatalog(this.container);
+
+  int _owner(String? profileId) {
+    final profile = NativeWorkspace(container).profile(profileId);
+    if (profile.type != ProfileType.custom) {
+      throw const NativeControlException('代理组属于自定义配置，请先创建或选择自定义配置。');
+    }
+    return profile.id;
+  }
+
+  Future<List<Map<String, Object?>>> list(
+    String kind,
+    String? profileId,
+  ) async {
+    switch (kind) {
+      case 'proxies':
+        final items = await container.read(customProxiesProvider.future);
+        return Isolate.run(
+          () => [
+            for (final item in items)
+              {
+                'id': item.id.toString(),
+                'label': item.name,
+                'detail': item.type,
+              },
+          ],
+        );
+      case 'groups':
+        final items = await container.read(
+          proxyGroupsProvider(_owner(profileId)).future,
+        );
+        return Isolate.run(
+          () => [
+            for (final item in items)
+              {
+                'id': item.id.toString(),
+                'label': item.name,
+                'detail': item.type.value,
+              },
+          ],
+        );
+      case 'scripts':
+        final items = await container.read(scriptsProvider.future);
+        return Isolate.run(
+          () => [
+            for (final item in items)
+              {
+                'id': item.id.toString(),
+                'label': item.label,
+                'detail': item.url ?? '本地脚本',
+              },
+          ],
+        );
+      default:
+        throw const NativeControlException('不支持的资源分类。');
+    }
+  }
+
+  Future<Map<String, Object?>> read(
+    String kind,
+    String? id,
+    String? profileId,
+  ) async {
+    if (!_kinds.contains(kind)) throw const NativeControlException('不支持的资源分类。');
+    final items = await list(kind, profileId);
+    if (id != null && !items.any((item) => item['id'] == id)) {
+      throw const NativeControlException('资源已被删除，请刷新列表。', 404);
+    }
+    Object? value;
+    switch (kind) {
+      case 'proxies':
+        final proxies = await container.read(customProxiesProvider.future);
+        value = id == null
+            ? {
+                'name': '新节点',
+                'type': 'socks5',
+                'server': '127.0.0.1',
+                'port': 1080,
+              }
+            : proxies.firstWhere((item) => item.id.toString() == id).definition;
+      case 'groups':
+        final groups = await container.read(
+          proxyGroupsProvider(_owner(profileId)).future,
+        );
+        value = id == null
+            ? {
+                'name': '新代理组',
+                'type': 'select',
+                'proxies': ['DIRECT'],
+              }
+            : groups.firstWhere((item) => item.id.toString() == id).definition;
+      case 'scripts':
+        final script = (await container.read(
+          scriptsProvider.future,
+        )).firstWhereOrNull((item) => item.id.toString() == id);
+        value = {
+          'label': script?.label ?? '新脚本',
+          'url': script?.url,
+          'content': script == null
+              ? 'function main(config) {\n  return config;\n}\n'
+              : await script.content ?? '',
+        };
+    }
+    final dependencies = kind == 'scripts'
+        ? items
+        : {
+            'items': items,
+            'proxies': await container.read(customProxiesProvider.future),
+            'groups': (await container.read(
+              customGroupNamesProvider.future,
+            )).toList()..sort(),
+          };
+    final seed = await Isolate.run(
+      () => jsonEncode([kind, profileId, id, dependencies]),
+    );
+    return nativeDocument(kind, value, revisionSeed: seed);
+  }
+
+  Future<void> _unchanged(
+    String kind,
+    String? id,
+    String? profileId,
+    String revision,
+  ) async {
+    if ((await read(kind, id, profileId))['revision'] != revision) {
+      throw const NativeControlException('资源或引用已被其他界面修改，请重新载入。', 409);
+    }
+  }
+
+  Future<void> save(
+    String kind,
+    String? id,
+    String? profileId,
+    String text,
+    String revision,
+  ) async {
+    await _unchanged(kind, id, profileId, revision);
+    final edit = await Isolate.run(() {
+      if (utf8.encode(text).length > 4 * 1024 * 1024)
+        throw const NativeControlException('内容不能超过 4 MiB。', 413);
+      final value = jsonDecode(text);
+      if (value is! Map<String, dynamic>)
+        throw const NativeControlException('资源需要 JSON 对象。');
+      return value;
+    });
+    Future<void> Function() persist;
+    switch (kind) {
+      case 'proxies':
+        final proxies = await container.read(customProxiesProvider.future);
+        final names = await container.read(customGroupNamesProvider.future);
+        final previous = proxies.firstWhereOrNull(
+          (item) => item.id.toString() == id,
+        );
+        final identity = previous?.id ?? snowflake.id;
+        final next = await Isolate.run(() {
+          final proxy =
+              previous?.copyWith(definition: edit) ??
+              CustomProxy.fromDefinition(edit, id: identity);
+          if (edit['name'] is! String ||
+              edit['type'] is! String ||
+              customProxyIssues(
+                proxy,
+                proxies: proxies,
+                groupNames: names,
+              ).isNotEmpty) {
+            throw const NativeControlException(
+              '节点名称或类型无效，名称不能与其他节点、代理组或保留名称重复。',
+            );
+          }
+          return proxy;
+        });
+        final errors = await container
+            .read(coreHandlerProvider)
+            .validateProxies([next.definition]);
+        if (errors.length != 1 || errors.single.isNotEmpty) {
+          throw NativeControlException(
+            errors.length == 1 ? errors.single : '核心未完成节点校验。',
+            422,
+          );
+        }
+        persist = () =>
+            container.read(customProxiesProvider.notifier).putAndWait(next);
+      case 'groups':
+        final owner = _owner(profileId);
+        final groups = await container.read(proxyGroupsProvider(owner).future);
+        await container.read(customProxiesProvider.future);
+        await container.read(proxyDialersProvider(owner).future);
+        await container.read(clashProvidersProvider.future);
+        final data = container.read(customProfileDataProvider(owner));
+        if (data == null)
+          throw const NativeControlException('自定义配置尚未载入，请稍后重试。', 409);
+        final previous = groups.firstWhereOrNull(
+          (item) => item.id.toString() == id,
+        );
+        final base =
+            previous ??
+            ProxyGroup(
+              id: snowflake.id,
+              name: '',
+              type: GroupType.Selector,
+              profileId: owner,
+            );
+        final next = await Isolate.run(() {
+          final shown = base.definition;
+          final group = ProxyGroup.fromJson({
+            for (final entry in base.toJson().entries)
+              if (!shown.containsKey(entry.key) && entry.key != 'use-position')
+                entry.key: entry.value,
+            ...edit,
+            'id': base.id,
+            'profileId': owner,
+            'order': base.order,
+          });
+          final normalized = group.definition;
+          if (!const DeepCollectionEquality().equals(edit, normalized)) {
+            throw const NativeControlException('包含未知、无效或不适用于此类型的代理组字段。');
+          }
+          final blocking = proxyGroupIssues(group, data).where(
+            (issue) => switch (issue) {
+              EmptyNameIssue() ||
+              ReservedNameIssue() ||
+              DuplicateNameIssue() ||
+              NoProxySourceIssue() ||
+              GroupLoopIssue() ||
+              DialerLoopIssue() ||
+              InvalidEmptyFallbackIssue() => true,
+              _ => false,
+            },
+          );
+          if (blocking.isNotEmpty)
+            throw const NativeControlException(
+              '代理组存在名称冲突、空来源或循环引用，请检查成员与回退设置。',
+            );
+          return group;
+        });
+        final errors = await container
+            .read(coreHandlerProvider)
+            .validateFilters([next.filter ?? '', next.excludeFilter ?? '']);
+        if (errors.length != 2 || errors.any((error) => error.isNotEmpty)) {
+          throw const NativeControlException('代理组正则表达式无效，或核心未完成校验。', 422);
+        }
+        persist = () async {
+          if (!await container
+              .read(proxyGroupsProvider(owner).notifier)
+              .putAndWait(next)) {
+            throw const NativeControlException('代理组名称已存在。', 409);
+          }
+        };
+      case 'scripts':
+        final scripts = await container.read(scriptsProvider.future);
+        if (!const SetEquality<String>().equals(edit.keys.toSet(), {
+              'label',
+              'url',
+              'content',
+            }) ||
+            edit['label'] is! String ||
+            (edit['label'] as String).trim().isEmpty ||
+            edit['content'] is! String ||
+            (edit['url'] != null && edit['url'] is! String)) {
+          throw const NativeControlException('脚本需要 label、content 字符串和可空的 url。');
+        }
+        final label = edit['label'] as String;
+        final url = edit['url'] as String?;
+        if (url != null && url.isNotEmpty) {
+          final uri = Uri.tryParse(url);
+          if (uri == null ||
+              !['http', 'https'].contains(uri.scheme) ||
+              uri.host.isEmpty)
+            throw const NativeControlException('脚本地址应为 HTTP(S)。');
+        }
+        if (scripts.any(
+          (script) => script.label == label && script.id.toString() != id,
+        ))
+          throw const NativeControlException('脚本名称已存在。', 409);
+        final previous = scripts.firstWhereOrNull(
+          (item) => item.id.toString() == id,
+        );
+        final next =
+            previous?.copyWith(label: label, url: url) ??
+            Script.create(label: label, url: url);
+        persist = () async {
+          final oldContent = previous == null ? null : await previous.content;
+          final saved = await next.save(edit['content'] as String);
+          try {
+            await container.read(scriptsProvider.notifier).putAndWait(saved);
+          } catch (_) {
+            if (oldContent != null) await previous!.save(oldContent);
+            rethrow;
+          }
+        };
+      default:
+        throw const NativeControlException('不支持的资源分类。');
+    }
+    await _unchanged(kind, id, profileId, revision);
+    await persist();
+    await _apply(kind, id, profileId);
+  }
+
+  Future<void> delete(
+    String kind,
+    String id,
+    String? profileId,
+    String revision,
+  ) async {
+    await _unchanged(kind, id, profileId, revision);
+    final identity = int.parse(id);
+    switch (kind) {
+      case 'proxies':
+        await container.read(customProxiesProvider.notifier).delAllAndWait([
+          identity,
+        ]);
+      case 'groups':
+        await container
+            .read(proxyGroupsProvider(_owner(profileId)).notifier)
+            .delAllAndWait([identity]);
+      case 'scripts':
+        if (container
+            .read(profilesProvider)
+            .any((profile) => profile.scriptId == identity))
+          throw const NativeControlException('配置仍引用此脚本，请先更换配置扩展脚本。', 409);
+        await container.read(scriptsProvider.notifier).delAndWait(identity);
+      default:
+        throw const NativeControlException('不支持的资源分类。');
+    }
+    await _apply(kind, id, profileId);
+  }
+
+  Future<void> _apply(String kind, String? id, String? profileId) async {
+    final current = container.read(currentProfileProvider);
+    if (current == null ||
+        (kind == 'groups' && current.id.toString() != profileId) ||
+        (kind == 'proxies' && current.type != ProfileType.custom) ||
+        (kind == 'scripts' &&
+            (current.extendType != ExtendType.script ||
+                current.scriptId?.toString() != id)))
+      return;
+    if (!await container
+        .read(setupActionProvider.notifier)
+        .applyProfile(force: true)) {
+      throw const NativeControlException('资源已保存，但当前配置应用失败，请检查主程序。', 422);
+    }
+  }
+}
diff --git a/lib/native/control_server.dart b/lib/native/control_server.dart
new file mode 100644
index 00000000..b215f37a
--- /dev/null
+++ b/lib/native/control_server.dart
@@ -0,0 +1,142 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'dart:isolate';
+
+typedef NativeAction =
+    Future<Map<String, Object?>> Function(Map<String, Object?> command);
+
+Future<Object?> _decodeRequest(List<int> bytes) =>
+    Isolate.run(() => jsonDecode(utf8.decode(bytes)));
+
+Future<String> _encodeResponse(Map<String, Object?> value) =>
+    Isolate.run(() => jsonEncode(value));
+
+class NativeControlException implements Exception {
+  final String message;
+  final int status;
+
+  const NativeControlException(this.message, [this.status = 400]);
+}
+
+class NativeControlServer {
+  final String Function() secret;
+  final Future<Map<String, Object?>> Function() snapshot;
+  final NativeAction action;
+  HttpServer? _server;
+  bool _busy = false;
+  bool _closed = false;
+
+  NativeControlServer({
+    required this.secret,
+    required this.snapshot,
+    required this.action,
+  });
+
+  Future<void> start({int port = 9097}) async {
+    if (_closed || _server != null) return;
+    if (secret().isEmpty) {
+      throw const NativeControlException('请先设置外部控制器密钥。');
+    }
+    final server = await HttpServer.bind(InternetAddress.loopbackIPv4, port);
+    if (_closed) {
+      await server.close(force: true);
+      return;
+    }
+    _server = server;
+    server.listen((request) => unawaited(_handle(request)));
+  }
+
+  bool accepts(String? authorization, {String? origin}) {
+    final token = secret();
+    return !_closed &&
+        token.isNotEmpty &&
+        origin == null &&
+        authorization == 'Bearer $token';
+  }
+
+  Future<Map<String, Object?>> dispatch(
+    String method,
+    String path,
+    Map<String, Object?> body,
+  ) async {
+    if (_closed) {
+      throw const NativeControlException('管理桥已关闭。', 503);
+    }
+    if (method == 'GET' && path == '/state') return snapshot();
+    if (method != 'POST' || path != '/action') {
+      throw const NativeControlException('没有这个管理接口。', 404);
+    }
+    if (_busy) {
+      throw const NativeControlException('正在处理其他管理操作，请稍后重试。', 409);
+    }
+    _busy = true;
+    try {
+      return await action(body);
+    } finally {
+      _busy = false;
+    }
+  }
+
+  Future<void> _handle(HttpRequest request) async {
+    final response = request.response;
+    response.headers.contentType = ContentType.json;
+    response.headers.set(HttpHeaders.cacheControlHeader, 'no-store');
+    try {
+      if (request.connectionInfo?.remoteAddress.isLoopback != true ||
+          !accepts(
+            request.headers.value(HttpHeaders.authorizationHeader),
+            origin: request.headers.value('origin'),
+          )) {
+        throw const NativeControlException('管理桥拒绝访问，请检查密钥。', 403);
+      }
+      final bytes = <int>[];
+      if (request.method == 'POST') {
+        if (request.headers.contentType?.mimeType != 'application/json') {
+          throw const NativeControlException('管理请求需要 JSON。', 415);
+        }
+        await for (final chunk in request.timeout(
+          const Duration(seconds: 15),
+        )) {
+          if (bytes.length + chunk.length > 8 * 1024 * 1024) {
+            throw const NativeControlException('配置文件不能超过 8 MiB。', 413);
+          }
+          bytes.addAll(chunk);
+        }
+      }
+      final decoded = bytes.isEmpty
+          ? <String, Object?>{}
+          : await _decodeRequest(bytes);
+      if (decoded is! Map<String, dynamic>) {
+        throw const NativeControlException('管理请求格式无效。');
+      }
+      final result = await dispatch(request.method, request.uri.path, decoded);
+      response.write(await _encodeResponse(result));
+    } on NativeControlException catch (error) {
+      response.statusCode = error.status;
+      response.write(jsonEncode({'message': error.message}));
+    } on FormatException {
+      response.statusCode = 400;
+      response.write(jsonEncode({'message': '管理请求格式无效。'}));
+    } catch (_) {
+      response.statusCode = 500;
+      response.write(
+        jsonEncode({'message': '管理操作未完成，请在 FlClash 中检查权限、下载或配置错误。'}),
+      );
+    } finally {
+      try {
+        await response.close();
+      } on SocketException {
+        return;
+      } on HttpException {
+        return;
+      }
+    }
+  }
+
+  Future<void> close() async {
+    _closed = true;
+    await _server?.close(force: true);
+    _server = null;
+  }
+}
