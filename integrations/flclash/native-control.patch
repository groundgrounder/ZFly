@@ -0,0 +1,583 @@
+import 'dart:convert';
+import 'dart:isolate';
+
+import 'package:collection/collection.dart';
+import 'package:crypto/crypto.dart';
+import 'package:fl_clash/common/common.dart';
+import 'package:fl_clash/common/dav_client.dart';
+import 'package:fl_clash/enum/enum.dart';
+import 'package:fl_clash/models/models.dart';
+import 'package:fl_clash/providers/providers.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import 'control_server.dart';
+
+const _patchSections = {
+  'dns': {'dns', 'dns-override-keys', 'hosts'},
+  'tun': {'tun', 'tun-override', 'tun-override-keys'},
+  'geo': {
+    'geox-url',
+    'geodata-loader',
+    'geo-auto-update',
+    'geo-update-interval',
+  },
+};
+const _profileKeys = {'extendType', 'scriptId', 'matchTarget'};
+const _titles = {
+  'core': '持久化核心设置',
+  'dns': 'DNS 与 hosts',
+  'tun': 'TUN 与路由覆盖',
+  'geo': 'Geo 资源',
+  'app': '主程序偏好',
+  'proxyStyle': '主程序代理显示',
+  'hotkeys': '主程序快捷键',
+  'wifi': '排除的 Wi-Fi',
+  'network': '网络与代理认证',
+  'dav': 'WebDAV 备份连接',
+  'profile': '配置扩展方式',
+  'profileOverrides': '配置专属覆盖',
+  'globalRules': '全局追加规则',
+  'profileRules': '配置追加规则',
+  'logs': '日志',
+  'dnsQueries': 'DNS 记录',
+  'requests': '请求历史',
+  'providers': '运行中的提供者',
+  'resources': '资源清单',
+};
+
+Object? _canonical(Object? value) {
+  if (value is Map) {
+    return {
+      for (final key in value.keys.map((key) => key.toString()).sorted())
+        key: _canonical(value[key]),
+    };
+  }
+  if (value is List) return value.map(_canonical).toList();
+  return value;
+}
+
+Future<Map<String, Object?>> nativeDocument(
+  String section,
+  Object? value, {
+  bool writable = true,
+  bool rules = false,
+  String revisionSeed = '',
+}) => Isolate.run(() {
+  final text = rules
+      ? (value as List<Rule>).map((rule) => rule.rawValue).join('\n')
+      : const JsonEncoder.withIndent(
+          '  ',
+        ).convert(_canonical(jsonDecode(jsonEncode(value))));
+  if (utf8.encode(text).length > 4 * 1024 * 1024) {
+    throw const NativeControlException('该内容超过原生编辑器的 4 MiB 限制。', 413);
+  }
+  return {
+    'section': section,
+    'title':
+        _titles[section] ??
+        const {
+          'proxies': '自定义节点',
+          'groups': '自定义代理组',
+          'scripts': '扩展脚本',
+        }[section] ??
+        section,
+    'text': text,
+    'revision': sha256.convert(utf8.encode('$text$revisionSeed')).toString(),
+    'writable': writable,
+    'format': rules ? 'rules' : 'json',
+  };
+});
+
+Map<String, Object?> _pick(
+  Map<String, dynamic> source,
+  Iterable<String> keys,
+) => {for (final key in keys) key: source[key]};
+
+Set<String> _patchKeys(String section, Map<String, dynamic> source) =>
+    _patchSections[section] ??
+    source.keys
+        .where(
+          (key) => !{
+            'secret',
+            'external-controller',
+            ..._patchSections.values.expand((keys) => keys),
+          }.contains(key),
+        )
+        .toSet();
+
+Map<String, Object?> _object(Object? value) {
+  if (value is! Map<String, dynamic>)
+    throw const NativeControlException('此设置需要 JSON 对象。');
+  return value;
+}
+
+void _same(Object? input, Object? normalized) {
+  if (!const DeepCollectionEquality().equals(
+    _canonical(input),
+    _canonical(jsonDecode(jsonEncode(normalized))),
+  )) {
+    throw const NativeControlException('包含未知字段或无效值；请保留字段名，并检查枚举、列表和数值类型。');
+  }
+}
+
+PatchClashConfig _patch(
+  Map<String, Object?> source,
+  Map<String, Object?> edit,
+) {
+  final result = PatchClashConfig.fromJson({...source, ...edit});
+  _same(edit, _pick(result.toJson(), edit.keys));
+  final ports = [
+    result.mixedPort,
+    result.port,
+    result.socksPort,
+    result.redirPort,
+    result.tproxyPort,
+  ];
+  if (ports.any((port) => port < 0 || port > 65535) ||
+      result.geoUpdateInterval < 1 ||
+      result.keepAliveIdle < 0 ||
+      result.keepAliveInterval < 0 ||
+      result.routingMark < 0) {
+    throw const NativeControlException(
+      '端口范围为 0–65535；更新间隔应为正数，连接保活和路由标记不能为负数。',
+    );
+  }
+  final active = ports.where((port) => port != 0).toList();
+  if (active.toSet().length != active.length)
+    throw const NativeControlException('多个监听不能使用相同端口。');
+  return result;
+}
+
+class NativeWorkspace {
+  final ProviderContainer container;
+  NativeWorkspace(this.container);
+
+  Profile profile(String? id) {
+    final result = container
+        .read(profilesProvider)
+        .getProfile(int.tryParse(id ?? ''));
+    if (result == null)
+      throw const NativeControlException('配置已不存在，请刷新列表。', 404);
+    return result;
+  }
+
+  Future<Map<String, Object?>> read(String section, String? id) async {
+    if (!_titles.containsKey(section))
+      throw const NativeControlException('不支持的设置分类。');
+    if (section == 'core' || _patchSections.containsKey(section)) {
+      final patch = container.read(patchClashConfigProvider);
+      return Isolate.run(() {
+        final source = patch.toJson();
+        final keys =
+            _patchSections[section] ??
+            source.keys
+                .where(
+                  (key) => !{
+                    'secret',
+                    'external-controller',
+                    ..._patchSections.values.expand((keys) => keys),
+                  }.contains(key),
+                )
+                .toSet();
+        return _pick(source, keys);
+      }).then((value) => nativeDocument(section, value));
+    }
+    switch (section) {
+      case 'app':
+        return nativeDocument(section, container.read(appSettingProvider));
+      case 'proxyStyle':
+        return nativeDocument(
+          section,
+          container.read(proxiesStyleSettingProvider),
+        );
+      case 'hotkeys':
+        return nativeDocument(section, container.read(hotKeyActionsProvider));
+      case 'wifi':
+        return nativeDocument(section, container.read(excludeSSIDsProvider));
+      case 'network':
+        return nativeDocument(section, container.read(networkSettingProvider));
+      case 'dav':
+        final dav = container.read(davSettingProvider);
+        return nativeDocument(section, {
+          'uri': dav?.uri ?? '',
+          'user': dav?.user ?? '',
+          'fileName': dav?.fileName ?? defaultDavFileName,
+          'password': null,
+        }, revisionSeed: dav?.password ?? '');
+      case 'profile':
+        return nativeDocument(
+          section,
+          _pick(profile(id).toJson(), _profileKeys),
+        );
+      case 'profileOverrides':
+        return nativeDocument(section, profile(id).overrides);
+      case 'globalRules':
+        return nativeDocument(
+          section,
+          await container.read(globalRulesProvider.future),
+          rules: true,
+        );
+      case 'profileRules':
+        return nativeDocument(
+          section,
+          await container.read(profileRulesProvider(profile(id).id).future),
+          rules: true,
+        );
+      case 'logs':
+        return nativeDocument(
+          section,
+          container.read(logsProvider).list,
+          writable: false,
+        );
+      case 'dnsQueries':
+        return nativeDocument(
+          section,
+          container.read(dnsQueriesProvider).list,
+          writable: false,
+        );
+      case 'requests':
+        return nativeDocument(
+          section,
+          container.read(requestsProvider).list,
+          writable: false,
+        );
+      case 'providers':
+        return nativeDocument(
+          section,
+          await container.read(coreHandlerProvider).getExternalProviders(),
+          writable: false,
+        );
+      case 'resources':
+        final scripts = await container.read(scriptsProvider.future);
+        final providers = await container.read(clashProvidersProvider.future);
+        final icons = await container.read(iconSetsProvider.future);
+        return nativeDocument(section, {
+          'scripts': scripts,
+          'ruleProviders': providers,
+          'iconSets': icons,
+        }, writable: false);
+    }
+    throw const NativeControlException('不支持的设置分类。');
+  }
+
+  Future<Map<String, Object?>> write(
+    String section,
+    String? id,
+    String text,
+    String revision,
+  ) async {
+    final current = await read(section, id);
+    if (current['writable'] != true)
+      throw const NativeControlException('此分类只读。');
+    if (current['revision'] != revision)
+      throw const NativeControlException('内容已被其他界面修改，请先重新载入。', 409);
+    if (utf8.encode(text).length > 4 * 1024 * 1024)
+      throw const NativeControlException('内容不能超过 4 MiB。', 413);
+    var apply = false;
+    Future<void> Function() persist;
+    if (section == 'globalRules' || section == 'profileRules') {
+      final owner = section == 'profileRules' ? profile(id).id : null;
+      final previous = owner == null
+          ? await container.read(globalRulesProvider.future)
+          : await container.read(profileRulesProvider(owner).future);
+      final next = await Isolate.run(() {
+        final List<Rule> rules;
+        try {
+          rules = decodeRuleList(
+            text,
+            previous: previous,
+          ).map((item) => item.rule).toList();
+        } on RuleLineException catch (error) {
+          throw NativeControlException('第 ${error.line} 行规则无效。');
+        }
+        final orders = indexing.generateNKeys(rules.length);
+        return [
+          for (final (index, rule) in rules.indexed)
+            rule.copyWith(order: orders[index]),
+        ];
+      });
+      persist = () => owner == null
+          ? container.read(globalRulesProvider.notifier).replaceAndWait(next)
+          : container
+                .read(profileRulesProvider(owner).notifier)
+                .replaceAndWait(next);
+      apply =
+          owner == null || owner == container.read(currentProfileIdProvider);
+    } else {
+      final value = await Isolate.run(() => jsonDecode(text));
+      if (section == 'core' || _patchSections.containsKey(section)) {
+        final patch = container.read(patchClashConfigProvider);
+        final next = await Isolate.run(() {
+          final source = patch.toJson();
+          final edit = _object(value);
+          _same(
+            edit.keys.toSet().toList()..sort(),
+            _patchKeys(section, source).toList()..sort(),
+          );
+          return _patch(source, edit);
+        });
+        persist = () async {
+          container.read(patchClashConfigProvider.notifier).value = next;
+        };
+        apply = true;
+      } else {
+        switch (section) {
+          case 'network':
+            final next = await Isolate.run(() {
+              final result = NetworkProps.fromJson(_object(value));
+              _same(value, result);
+              if (result.authentication.username.contains(':') ||
+                  [
+                    result.authentication.username,
+                    result.authentication.password,
+                    ...result.bypassDomain,
+                  ].any((item) => item.contains('\n') || item.contains('\r'))) {
+                throw const NativeControlException(
+                  '认证用户名不能包含冒号，认证与绕过地址不能包含换行。',
+                );
+              }
+              return result;
+            });
+            persist = () async {
+              container.read(networkSettingProvider.notifier).value = next;
+            };
+            apply = true;
+          case 'dav':
+            final edit = _object(value);
+            if (!const SetEquality<String>().equals(edit.keys.toSet(), {
+                  'uri',
+                  'user',
+                  'fileName',
+                  'password',
+                }) ||
+                edit['uri'] is! String ||
+                edit['user'] is! String ||
+                edit['fileName'] is! String ||
+                (edit['password'] != null && edit['password'] is! String)) {
+              throw const NativeControlException(
+                'WebDAV 需要 uri、user、fileName 字符串；password 为 null 时保留已有密码。',
+              );
+            }
+            final uri = Uri.tryParse(edit['uri'] as String);
+            final fileName = edit['fileName'] as String;
+            if (uri == null ||
+                !['http', 'https'].contains(uri.scheme) ||
+                uri.host.isEmpty ||
+                uri.userInfo.isNotEmpty ||
+                uri.hasQuery ||
+                uri.hasFragment ||
+                fileName.trim().isEmpty ||
+                fileName == '.' ||
+                fileName == '..' ||
+                fileName.contains('/') ||
+                fileName.contains('\\') ||
+                fileName.runes.any((code) => code < 32 || code == 127)) {
+              throw const NativeControlException(
+                'WebDAV 地址应为 HTTP(S)，备份文件名不能包含目录或控制字符。',
+              );
+            }
+            final next = DAVProps(
+              uri: uri.toString(),
+              user: edit['user'] as String,
+              fileName: fileName,
+              password:
+                  edit['password'] as String? ??
+                  container.read(davSettingProvider)?.password ??
+                  '',
+            );
+            persist = () async {
+              container.read(davSettingProvider.notifier).value = next;
+            };
+          case 'app':
+            final next = await Isolate.run(() {
+              final result = AppSettingProps.fromJson(_object(value));
+              _same(value, result);
+              return result;
+            });
+            persist = () async {
+              container.read(appSettingProvider.notifier).value = next;
+            };
+          case 'proxyStyle':
+            final next = await Isolate.run(() {
+              final result = ProxiesStyleProps.fromJson(_object(value));
+              _same(value, result);
+              return result;
+            });
+            persist = () async {
+              container.read(proxiesStyleSettingProvider.notifier).value = next;
+            };
+          case 'hotkeys':
+            final next = await Isolate.run(() {
+              if (value is! List)
+                throw const NativeControlException('快捷键需要 JSON 列表。');
+              final result = value
+                  .map((item) => HotKeyAction.fromJson(_object(item)))
+                  .toList();
+              _same(value, result);
+              return result;
+            });
+            persist = () async {
+              container.read(hotKeyActionsProvider.notifier).value = next;
+            };
+          case 'wifi':
+            if (value is! List ||
+                value.any((item) => item is! String || item.contains('\n')))
+              throw const NativeControlException('Wi-Fi 名称需要字符串列表。');
+            final next = value.cast<String>();
+            persist = () async {
+              container.read(excludeSSIDsProvider.notifier).value = next;
+            };
+          case 'profile':
+            final old = profile(id);
+            final next = await Isolate.run(() {
+              final edit = _object(value);
+              _same(
+                edit.keys.toSet().toList()..sort(),
+                _profileKeys.toList()..sort(),
+              );
+              final result = Profile.fromJson({...old.toJson(), ...edit});
+              _same(edit, _pick(result.toJson(), _profileKeys));
+              return result;
+            });
+            if (next.scriptId != null &&
+                !(await container.read(
+                  scriptsProvider.future,
+                )).any((script) => script.id == next.scriptId))
+              throw const NativeControlException('指定的脚本已不存在。');
+            persist = () =>
+                container.read(profilesProvider.notifier).putAndWait(next);
+            apply = old.id == container.read(currentProfileIdProvider);
+          case 'profileOverrides':
+            final old = profile(id);
+            final next = await Isolate.run(() {
+              final result = ProfileOverrides.fromJson(_object(value));
+              _same(value, result);
+              return result;
+            });
+            persist = () => container
+                .read(profilesProvider.notifier)
+                .putAndWait(old.copyWith(overrides: next));
+            apply = old.id == container.read(currentProfileIdProvider);
+          default:
+            throw const NativeControlException('不支持的设置分类。');
+        }
+      }
+    }
+    if ((await read(section, id))['revision'] != revision)
+      throw const NativeControlException('内容已被其他界面修改，请先重新载入。', 409);
+    await persist();
+    if (!await preferences.saveConfig(container.read(configProvider)))
+      throw const NativeControlException('内容已更新，但偏好保存失败。', 500);
+    if (apply &&
+        !await container
+            .read(setupActionProvider.notifier)
+            .applyProfile(force: true))
+      throw const NativeControlException('内容已保存，但核心应用失败，请检查主程序。', 422);
+    return read(section, id);
+  }
+
+  Future<String> tool(String name, String? target) async {
+    final core = container.read(coreHandlerProvider);
+    if (name == 'backupLocal') {
+      final saved = await container
+          .read(backupActionProvider.notifier)
+          .backup(
+            (path) async =>
+                await picker.saveFileWithPath(getBackupFileName(), path) !=
+                null,
+          );
+      return saved ? '备份已保存。' : '已取消备份。';
+    }
+    if (name == 'restoreLocalProfiles' || name == 'restoreLocalAll') {
+      final file = await picker.pickerFile();
+      if (file?.path == null) return '已取消恢复。';
+      await container
+          .read(backupActionProvider.notifier)
+          .restore(
+            name == 'restoreLocalAll'
+                ? RestoreOption.all
+                : RestoreOption.onlyProfiles,
+            (_) async => file!.path,
+          );
+      return '恢复完成；如果控制器密钥或地址发生变化，请重新连接。';
+    }
+    if ([
+      'testDAV',
+      'backupDAV',
+      'restoreDAVProfiles',
+      'restoreDAVAll',
+    ].contains(name)) {
+      final props = container.read(davSettingProvider);
+      if (props == null)
+        throw const NativeControlException('请先在 WebDAV 分类保存连接设置。');
+      final client = DAVClient(props);
+      if (name == 'testDAV') {
+        if (!await client.ping())
+          throw const NativeControlException(
+            'WebDAV 连接失败，请检查地址、认证及主程序日志。',
+            422,
+          );
+        return 'WebDAV 连接成功。';
+      }
+      if (name == 'backupDAV') {
+        await container.read(backupActionProvider.notifier).backup((
+          path,
+        ) async {
+          await client.upload(path);
+          return true;
+        });
+        return '备份已上传到 WebDAV。';
+      }
+      await container.read(backupActionProvider.notifier).restore(
+        name == 'restoreDAVAll'
+            ? RestoreOption.all
+            : RestoreOption.onlyProfiles,
+        (path) async {
+          await client.download(path);
+          return path;
+        },
+      );
+      return '恢复完成；如果控制器密钥或地址发生变化，请重新连接。';
+    }
+    switch (name) {
+      case 'apply':
+        if (!await container
+            .read(setupActionProvider.notifier)
+            .applyProfile(force: true))
+          throw const NativeControlException('核心未完成应用。', 422);
+      case 'restart':
+        if (!await container.read(coreActionProvider.notifier).restartCore())
+          throw const NativeControlException('核心未完成重启。', 422);
+      case 'gc':
+        await core.requestGc();
+      case 'closeConnections':
+        await core.closeConnections();
+      case 'updateProfiles':
+        await container.read(profilesActionProvider.notifier).updateProfiles();
+      case 'updateResources':
+        final failures = await container
+            .read(resourcesActionProvider.notifier)
+            .updateAll();
+        if (failures.isNotEmpty)
+          throw NativeControlException(
+            failures.map((item) => '${item.label}: ${item.message}').join('\n'),
+            422,
+          );
+        return '资源更新请求已提交；Geo 下载结果请查看日志。';
+      case 'updateProvider':
+        final providers = await core.getExternalProviders();
+        final provider = providers.firstWhereOrNull(
+          (item) => item.name == target,
+        );
+        if (provider == null)
+          throw const NativeControlException('提供者已不存在。', 404);
+        final error = await container
+            .read(proxiesActionProvider.notifier)
+            .updateProvider(provider);
+        if (error.isNotEmpty) throw NativeControlException(error, 422);
+      default:
+        throw const NativeControlException('不支持的工具操作。');
+    }
+    return '操作已完成。';
+  }
+}
